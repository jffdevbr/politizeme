# Copie para .env. No Docker Compose, só SESSION_SECRET e ANTHROPIC_API_KEY são lidos daqui.

# Banco (para rodar fora do Docker: `docker compose up db` e use esta URL)
DATABASE_URL=postgresql://politizeme:politizeme@localhost:5432/politizeme

# Segredo que assina o cookie de sessão. Troque por um valor longo e aleatório.
SESSION_SECRET=troque-este-segredo-em-producao-politizeme

# Opcional: ativa o modo LLM do Poli. Sem chave, o Poli responde por regras + banco.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
