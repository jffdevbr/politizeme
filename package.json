{
  "name": "politizeme",
  "version": "0.1.0",
  "private": true,
  "description": "Acompanhe o mandato dos deputados federais e senadores de SP com dados públicos oficiais.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "node prisma/seed.mjs",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma db push --skip-generate && node prisma/seed.mjs && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
